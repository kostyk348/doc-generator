[Unit]
Description=generator-doc-gost Microservice (ГОСТ Document Generator)
After=network.target

[Service]
Type=simple
User=tmdata
WorkingDirectory=/home/tmdata/develop/frontend/doc-generator
ExecStart=/usr/bin/node dist/server.cjs
Restart=on-failure
RestartSec=5s
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/home/tmdata/develop/frontend/doc-generator/.env
StandardOutput=append:/var/log/tmdata/docgen.log
StandardError=append:/var/log/tmdata/docgen-error.log

[Install]
WantedBy=multi-user.target
